# Bu faylı .env adı ilə kopyala və öz dəyərlərini yaz.
# .env faylını HEÇ VAXT GitHub-a yükləmə (.gitignore-da var).

# Python skriptləri üçün PostgreSQL bağlantısı
DATABASE_URL=postgresql+psycopg2://app:app123@localhost:5432/layihe

# n8n-də credential kimi daxil edilir (Header Auth: Authorization = Bearer <açar>)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# n8n-də Telegram credential və W3 workflow-u üçün
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789