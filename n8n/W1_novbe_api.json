      "typeVersion": 2,
      "position": [
        240,
        220
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(\n         json_agg(json_build_object(\n           'id',   s.id,\n           'date', to_char(s.start_at, 'YYYY-MM-DD'),\n           'time', to_char(s.start_at, 'HH24:MI')\n         ) ORDER BY s.start_at),\n         '[]'::json) AS slots\n  FROM slots s\n WHERE s.doctor_id     = $1::int\n   AND s.start_at::date = $2::date\n   AND s.status        = 'free'\n   AND s.start_at      > now();",
        "options": {
          "queryReplacement": "={{ [ $json.query.doctor_id, $json.query.date ] }}"
        }
      },
      "id": "30a88603-f81b-4c5b-a865-c772fc3d15ef",
