    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "fee789b4-9fe9-4429-859a-0ca45bd71f80",
              "leftValue": "={{ Number.isInteger(Number($json.body.slot_id)) && ($json.body.full_name || '').trim().length >= 3 && /^\\+?[0-9 ]{9,15}$/.test($json.body.phone || '') }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e3e30686-067e-4c54-9f2b-968e73a94452",
      "name": "Yoxla book",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        500
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (\n    UPDATE slots\n       SET status = 'booked'\n     WHERE id = $1::int\n       AND status = 'free'\n       AND start_at > now()\n RETURNING id, doctor_id, start_at\n), p AS (\n    INSERT INTO patients (full_name, phone)\n    SELECT $2, $3\n     WHERE EXISTS (SELECT 1 FROM s)\n    ON CONFLICT (phone) DO UPDATE SET full_name = EXCLUDED.full_name\n RETURNING id\n), a AS (\n    INSERT INTO appointments (slot_id, patient_id, complaint, status, reminded)\n    SELECT s.id, p.id, $4, 'booked', false\n      FROM s, p\n RETURNING id, slot_id\n)\nSELECT (\n    SELECT json_build_object(\n             'appointment_id', a.id,\n             'doctor',    d.full_name,\n             'specialty', d.specialty,\n             'start_at',  to_char(s.start_at, 'DD.MM.YYYY HH24:MI'))\n      FROM a\n      JOIN s ON s.id = a.slot_id\n      JOIN doctors d ON d.id = s.doctor_id\n) AS appointment;",
        "options": {
          "queryReplacement": "={{ [ $json.body.slot_id, $json.body.full_name.trim(), $json.body.phone.replace(/\\s/g, ''), $json.body.complaint || '' ] }}"
        }
      },
      "id": "55127a69-4a9c-4f1a-91c5-3db20b50172b",
