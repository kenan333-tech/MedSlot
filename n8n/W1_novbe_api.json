    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH a AS (\n    UPDATE appointments\n       SET status = 'cancelled'\n     WHERE id = $1::int\n       AND status = 'booked'\n RETURNING slot_id\n), s AS (\n    UPDATE slots\n       SET status = 'free'\n     WHERE id IN (SELECT slot_id FROM a)\n RETURNING id, start_at\n)\nSELECT (\n    SELECT json_build_object(\n             'slot_id', s.id,\n             'start_at', to_char(s.start_at, 'DD.MM.YYYY HH24:MI'))\n      FROM s\n) AS freed;",
        "options": {
          "queryReplacement": "={{ [ $json.body.appointment_id ] }}"
        }
      },
