    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"openai/gpt-oss-120b\",\n  temperature: 0.2,\n  response_format: { type: \"json_object\" },\n  messages: [\n    { role: \"system\", content: \"Sən klinikada qeydiyyat köməkçisisən. Pasiyentin şikayətinə görə YALNIZ bu siyahıdan BİR ixtisas seç: \" + $json.specialties + \". Diaqnoz qoyma, dərman adı çəkmə. Əgər şikayətdə təcili hal əlaməti varsa (sinə ağrısı ilə təngnəfəslik, huşun itməsi, üz və ya qolda qəfil keyimə, güclü qanaxma), urgent = true yaz. Yalnız JSON qaytar, başqa heç nə yazma. Nümunə: {\\\"specialty\\\": \\\"Nevroloq\\\", \\\"reason\\\": \\\"Tez-tez təkrarlanan baş ağrısı nevroloji müayinə tələb edir.\\\", \\\"urgent\\\": false}. reason Azərbaycan dilində, 1 qısa cümlə olsun.\" },\n    { role: \"user\", content: $('Webhook').item.json.body.complaint }\n  ]\n}) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "cbcc5a67-904c-4743-bb99-d83faafb2ed6",
      "name": "Groq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -40
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "groqapi",
          "name": "Groq API"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// AI-nin cavabı JSON olmaya və ya siyahıda olmayan ixtisas seçə bilər.\n// Belə olanda Terapevt-ə yönləndiririk (ümumi həkim).\nconst allowed = $('İxtisaslar').first().json.specialties.split(', ');\n\nlet ai = {};\ntry {\n  ai = JSON.parse($input.first().json.choices[0].message.content);\n} catch (e) {\n  ai = {};\n}\n\nconst ok = allowed.includes(ai.specialty);\n\n// Qorunma: mətn səhv kodlaşdırma ilə gəlsə (Çin simvolları), izahı göstərmirik\nconst broken = /[㐀-鿿]/.test(ai.reason || '');\n\nreturn [{\n  json: {\n    specialty: ok ? ai.specialty : 'Terapevt',\n    reason: ok && ai.reason && !broken ? ai.reason : 'Əvvəlcə terapevt müayinəsi tövsiyə olunur.',\n    urgent: ai.urgent === true,\n    ai_ok: ok,\n  },\n}];"
      },
      "id": "7b2c4915-957a-4ff9-b6fb-b88ca2dc5d0b",
      "name": "AI cavabını yoxla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -40
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(\n         json_agg(json_build_object(\n           'id', id,\n           'full_name', full_name,\n           'specialty', specialty,\n           'work_start', to_char(work_start, 'HH24:MI'),\n           'work_end',   to_char(work_end,   'HH24:MI')\n         )),\n         '[]'::json) AS doctors\n  FROM doctors\n WHERE specialty = $1;",
        "options": {
          "queryReplacement": "={{ [ $json.specialty ] }}"
        }
      },
